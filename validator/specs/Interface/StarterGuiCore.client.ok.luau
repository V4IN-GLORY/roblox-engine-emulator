local StarterGui = game:GetService("StarterGui")

StarterGui:SetCore("SendNotification", { Title = "Hello", Text = "Welcome!", Duration = 5 })
StarterGui:SetCore("ResetButtonCallback", false)
StarterGui:SetCore("ResetButtonCallback", Instance.new("BindableEvent"))
StarterGui:SetCore("ChatMakeSystemMessage", { Text = "Hi" })
StarterGui:SetCore("TopbarEnabled", false)
StarterGui:SetCore("ChatActive", false)
assert(StarterGui:GetCore("ChatActive") == false)
assert(type(StarterGui:GetCore("GetBlockedUserIds")) == "table")
StarterGui:GetCore("PlayerBlockedEvent").Event:Connect(function() end)

StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
assert(StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Backpack) == false)
assert(StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.All) == false)
StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, true)
assert(StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Backpack) == true)
StarterGui:SetCoreGuiEnabled("Chat", false)
assert(StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Chat) == false)
